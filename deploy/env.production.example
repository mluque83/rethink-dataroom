# /etc/dataroom/env — PRODUCTION configuration (mode 640 root:dataroom). NO real secrets in git.
# Generate secrets ON THE SERVER:  openssl rand -base64 48
APP_ENV=production
APP_URL=https://dataroom.rethinkmedical.es
APP_TIMEZONE=Europe/Madrid
NODE_ENV=production

# Managed PostgreSQL (encryption at rest ENABLED on the instance; TLS required)
DATABASE_URL=postgres://dataroom:REPLACE@REPLACE-HOST:5432/dataroom?sslmode=verify-full
BETTER_AUTH_SECRET=REPLACE_WITH_openssl_rand_base64_48
LOG_HMAC_KEY=REPLACE_WITH_openssl_rand_base64_32

# Private S3-compatible bucket in the EU (Scaleway fr-par example)
STORAGE_DRIVER=s3
S3_BUCKET=rethink-dataroom-prod
S3_REGION=fr-par
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_FORCE_PATH_STYLE=false
# AES256 if the provider accepts the header; otherwise bucket-default + default encryption on the bucket
S3_SSE=AES256
AWS_ACCESS_KEY_ID=REPLACE
AWS_SECRET_ACCESS_KEY=REPLACE

# Transactional e-mail over SMTP with TLS (Scaleway TEM example; SPF/DKIM/DMARC on rethinkmedical.es)
EMAIL_PROVIDER=smtp
EMAIL_FROM="Rethink Medical Data Room <no-reply@dataroom.rethinkmedical.es>"
SMTP_HOST=smtp.tem.scaleway.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE
SMTP_PASSWORD=REPLACE

SCANNER=clamav
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
DEV_ALLOW_UNSCANNED_RELEASE=false

CONVERTER_SANDBOX=bwrap
CONVERTER_TIMEOUT_SECONDS=120
CONVERTER_MEMORY_MB=1536
UPLOAD_MAX_MB=100
STORAGE_QUOTA_GB=50

# Encrypted nightly backups (age public key; the private key is kept offline by Rethink Medical)
BACKUP_AGE_RECIPIENT=age1REPLACE
BACKUP_DIR=/var/backups/dataroom
