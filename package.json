{
  "name": "rethink-dataroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker": "node --conditions=react-server --import tsx scripts/worker.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "db:seed:demo": "node --conditions=react-server --import tsx scripts/seed-demo.ts",
    "admin:create": "node --conditions=react-server --import tsx scripts/create-admin.ts",
    "import:folder": "node --conditions=react-server --import tsx scripts/import-folder.ts",
    "retention:apply": "node --conditions=react-server --import tsx scripts/retention.ts",
    "backup": "bash scripts/backup.sh",
    "restore:test": "bash scripts/restore-test.sh",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "typecheck": "tsc --noEmit",
    "import:mapped": "node --conditions=react-server --import tsx scripts/import-mapped.ts",
    "register:minimize": "node --conditions=react-server --import tsx scripts/minimize-register.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "better-auth": "^1.7.21",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.3.0",
    "jszip": "^3.10.2",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "otpauth": "^9.6.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
